rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isStringListBounded(listVal, maxLen) {
      return listVal is list
        && listVal.size() <= maxLen
        && (listVal.size() == 0 || (listVal[0] is string && listVal[0].size() <= 64));
    }

    function isValidAlertPrefs(prefs) {
      return prefs is map
        && prefs.keys().hasAll(['push', 'email', 'telegram', 'lineupConfirmed', 'valueBetFound', 'followedGoal'])
        && prefs.keys().hasOnly(['push', 'email', 'telegram', 'lineupConfirmed', 'valueBetFound', 'followedGoal'])
        && prefs.push is bool
        && prefs.email is bool
        && prefs.telegram is bool
        && prefs.lineupConfirmed is bool
        && prefs.valueBetFound is bool
        && prefs.followedGoal is bool;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'language', 'theme', 'plan', 'favoriteTeams', 'favoriteLeagues', 'alertPrefs', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'language', 'theme', 'plan', 'favoriteTeams', 'favoriteLeagues', 'alertPrefs', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == request.auth.uid && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && (!('email' in data) || (data.email is string && data.email.size() <= 160))
        && data.language is string && data.language in ['az', 'en', 'ru']
        && data.theme is string && data.theme in ['dark', 'light']
        && data.plan is string && data.plan in ['free', 'pro']
        && isStringListBounded(data.favoriteTeams, 20)
        && isStringListBounded(data.favoriteLeagues, 10)
        && isValidAlertPrefs(data.alertPrefs)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserCoupon(data) {
      return data.keys().hasAll(['ownerId', 'title', 'legs', 'combinedOdds', 'combinedProb', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'title', 'legs', 'combinedOdds', 'combinedProb', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 100
        && data.legs is list && data.legs.size() >= 1 && data.legs.size() <= 12 && data.legs[0] is map
        && data.combinedOdds is number && data.combinedOdds >= 1.01 && data.combinedOdds <= 10000
        && data.combinedProb is number && data.combinedProb >= 0 && data.combinedProb <= 100
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBankrollBet(data) {
      return data.keys().hasAll(['ownerId', 'matchLabel', 'selection', 'stake', 'odds', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'matchLabel', 'selection', 'stake', 'odds', 'status', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.matchLabel is string && data.matchLabel.size() >= 1 && data.matchLabel.size() <= 120
        && data.selection is string && data.selection.size() >= 1 && data.selection.size() <= 80
        && data.stake is number && data.stake > 0 && data.stake <= 1000000
        && data.odds is number && data.odds >= 1.01 && data.odds <= 1000
        && data.status is string && data.status in ['pending', 'won', 'lost', 'void']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidContestPrediction(data) {
      return data.keys().hasAll(['ownerId', 'displayName', 'matchId', 'homeScore', 'awayScore', 'points', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'displayName', 'matchId', 'homeScore', 'awayScore', 'points', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.matchId is string && data.matchId.size() <= 80 && isValidId(data.matchId)
        && data.homeScore is int && data.homeScore >= 0 && data.homeScore <= 20
        && data.awayScore is int && data.awayScore >= 0 && data.awayScore <= 20
        && data.points is int && data.points >= 0 && data.points <= 5
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTipsterFollow(data) {
      return data.keys().hasAll(['ownerId', 'tipsterId', 'createdAt'])
        && data.keys().hasOnly(['ownerId', 'tipsterId', 'createdAt'])
        && data.ownerId is string && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.tipsterId is string && data.tipsterId.size() <= 80 && isValidId(data.tipsterId)
        && data.createdAt is timestamp;
    }

    function isValidFeatureFlag(data) {
      return data.keys().hasAll(['key', 'label', 'enabled', 'updatedAt'])
        && data.keys().hasOnly(['key', 'label', 'enabled', 'updatedAt'])
        && data.key is string && data.key.size() <= 64 && isValidId(data.key)
        && data.label is string && data.label.size() >= 1 && data.label.size() <= 100
        && data.enabled is bool
        && data.updatedAt is timestamp;
    }

    function isValidFeaturedPick(data) {
      return data.keys().hasAll(['matchId', 'matchLabel', 'league', 'market', 'selection', 'odds', 'modelProb', 'edge', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['matchId', 'matchLabel', 'league', 'market', 'selection', 'odds', 'modelProb', 'edge', 'status', 'createdAt', 'updatedAt'])
        && data.matchId is string && data.matchId.size() <= 80 && isValidId(data.matchId)
        && data.matchLabel is string && data.matchLabel.size() >= 1 && data.matchLabel.size() <= 120
        && data.league is string && data.league.size() >= 1 && data.league.size() <= 80
        && data.market is string && data.market.size() >= 1 && data.market.size() <= 40
        && data.selection is string && data.selection.size() >= 1 && data.selection.size() <= 80
        && data.odds is number && data.odds >= 1.01 && data.odds <= 1000
        && data.modelProb is number && data.modelProb >= 0 && data.modelProb <= 100
        && data.edge is number && data.edge >= -100 && data.edge <= 100
        && data.status is string && data.status in ['pending', 'won', 'lost']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Admin Registry (read own status only; managed out-of-band)
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && request.auth.uid == adminId;
      allow list, create, update, delete: if false;
    }

    // Private User Profiles (PII Isolated)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().plan == 'free'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'language', 'theme', 'favoriteTeams', 'favoriteLeagues', 'alertPrefs', 'updatedAt']))
        );
      allow delete: if isAdmin() && isValidId(userId);
    }

    // User Saved Coupons
    match /coupons/{couponId} {
      allow get: if isSignedIn() && isValidId(couponId) && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(couponId)
        && isValidUserCoupon(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(couponId)
        && isValidUserCoupon(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (existing().ownerId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'legs', 'combinedOdds', 'combinedProb', 'updatedAt']))
        );
      allow delete: if isVerifiedUser() && isValidId(couponId) && (existing().ownerId == request.auth.uid || isAdmin());
    }

    // User Bankroll Bets (Terminal State Locked once settled)
    match /bankrollBets/{betId} {
      allow get: if isSignedIn() && isValidId(betId) && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(betId)
        && isValidBankrollBet(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(betId)
        && isValidBankrollBet(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().ownerId == request.auth.uid
            && existing().status == 'pending'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );
      allow delete: if isVerifiedUser() && isValidId(betId) && (existing().ownerId == request.auth.uid || isAdmin());
    }

    // Proqnoz Yarisi Predictions (Owner Scoped)
    match /contestPredictions/{predictionId} {
      allow get: if isSignedIn() && isValidId(predictionId) && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(predictionId)
        && isValidContestPrediction(incoming())
        && incoming().points == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(predictionId)
        && isValidContestPrediction(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().matchId == existing().matchId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().ownerId == request.auth.uid
            && existing().points == 0
            && incoming().points == 0
            && incoming().diff(existing()).affectedKeys().hasOnly(['homeScore', 'awayScore', 'updatedAt'])
          )
        );
      allow delete: if isVerifiedUser() && isValidId(predictionId) && (existing().ownerId == request.auth.uid || isAdmin());
    }

    // Tipster Follows (Owner Scoped)
    match /tipsterFollows/{followId} {
      allow get: if isSignedIn() && isValidId(followId) && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(followId)
        && isValidTipsterFollow(incoming())
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isVerifiedUser() && isValidId(followId) && (existing().ownerId == request.auth.uid || isAdmin());
    }

    // Public Feature Flags (Admin Write Only)
    match /featureFlags/{flagId} {
      allow get: if isValidId(flagId);
      allow list: if resource.data.key is string;
      allow create: if isAdmin() && isValidId(flagId) && isValidFeatureFlag(incoming()) && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(flagId) && isValidFeatureFlag(incoming()) && incoming().key == existing().key && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(flagId);
    }

    // Public Transparency Archive & Featured Picks (Admin Write Only)
    match /featuredPicks/{pickId} {
      allow get: if isValidId(pickId);
      allow list: if resource.data.status in ['pending', 'won', 'lost'];
      allow create: if isAdmin()
        && isValidId(pickId)
        && isValidFeaturedPick(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(pickId)
        && isValidFeaturedPick(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(pickId);
    }
  }
}
