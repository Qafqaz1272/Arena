# Football Data API Configuration (Server-Side Only — never commit real keys)
# Choose either API-Football (v3.football.api-sports.io) OR football-data.org (api.football-data.org/v4).
# If neither key is set, MatchEdge runs in clearly labeled DEMO MODE with sample data.

# Option 1: API-Football v3 (https://www.api-football.com/)
API_FOOTBALL_KEY=""

# Option 2: football-data.org v4 (https://www.football-data.org/)
FOOTBALL_DATA_API_KEY=""

# Cache TTL in seconds (default: 180 for live/today, 900 for standings)
FOOTBALL_CACHE_TTL_SECONDS="180"

# Optional Free Bookmaker Odds API (https://the-odds-api.com/ — free tier 500 req/month)
# When unset, Value Bets page uses manual bookmaker odds input.
THE_ODDS_API_KEY=""

# APP_URL: Automatically injected at runtime by the hosting platform.
APP_URL="MY_APP_URL"
